{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plugnmeet-docs-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "docs-mcp.plugnmeet.org", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DOCS_INDEX_URL": "https://www.plugnmeet.org/docs-index.json"
  }
}
